# --- PoolFlow environment ---
# Copy to .env and fill in. Never commit the real .env.

PORT=3000
NODE_ENV=development

# Session signing secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite file path
DATABASE_FILE=./data/poolflow.db

# Anthropic (booking assistant)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Set to false only in local dev when replaying webhooks by hand
VERIFY_TWILIO_SIGNATURE=true

# Shared secret required by POST /api/cron/reminders
CRON_SECRET=change-me-too

# Public base URL, used for Twilio signature validation
PUBLIC_BASE_URL=http://localhost:3000

